<!-- External Libraries for WebRTC, QR Generation & QR Scanning -->
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://unpkg.com/@zxing/library@0.21.3/umd/index.min.js"></script>

<script>
const $ = id => document.getElementById(id);
let peer = null, conn = null, room = null, files = [], cameraStream = null, reader = null, received = null;
let currentLang = 'ar';

const i18n = {
  ar: {
    disconnected: 'غير متصل',
    readyToPair: 'جاهز للربط',
    connected: 'متصل بالجهاز الآخر',
    connLost: 'انقطع الاتصال',
    connError: 'خطأ اتصال',
    creatingConn: 'جارٍ إنشاء اتصال آمن...',
    roomReady: 'الغرفة جاهزة. امسح QR أو أدخل الرمز على الجهاز الآخر.',
    peerPaired: 'تم ربط الجهاز الآخر بنجاح. يمكنك إرسال الملفات الآن.',
    createErr: 'تعذّر إنشاء الاتصال: ',
    peerClosed: 'انقطع الاتصال بالجهاز الآخر.',
    peerErr: 'حدث خطأ أثناء الاتصال.',
    invalidCode: 'أدخل رمزاً صحيحاً من 8 خانات.',
    connecting: 'جارٍ الاتصال بالجهاز المرسل...',
    connectedOk: 'تم الاتصال! أرسل الملفات من الجهاز الآخر.',
    connectErr: 'تعذّر الاتصال: ',
    codeRead: 'تمت قراءة رمز الربط. اضغط اتصال للمتابعة.',
    sendingDone: 'اكتمل إرسال الملفات.',
    sendingDoneShort: 'اكتمل الإرسال',
    sendStopped: 'توقف الإرسال. تحقق من اتصال الجهازين.',
    receiving: 'استقبال: ',
    receivingNotice: 'يتم استقبال ',
    download: 'تنزيل ',
    completed: 'اكتمل: ',
    receivedOk: 'تم استلام الملف بنجاح.',
    qrScanned: 'تم مسح الرمز. اضغط اتصال.',
    camErr: 'تعذّر تشغيل الكاميرا. استخدم إدخال الرمز يدوياً.'
  },
  en: {
    disconnected: 'Disconnected',
    readyToPair: 'Ready to pair',
    connected: 'Connected to peer',
    connLost: 'Disconnected',
    connError: 'Connection error',
    creatingConn: 'Creating secure connection...',
    roomReady: 'Room ready. Scan QR or enter code on the other device.',
    peerPaired: 'Device paired successfully. You can send files now.',
    createErr: 'Failed to create connection: ',
    peerClosed: 'Connection to the other device was lost.',
    peerErr: 'An error occurred during connection.',
    invalidCode: 'Please enter a valid 8-character code.',
    connecting: 'Connecting to sender device...',
    connectedOk: 'Connected! Send files from the other device.',
    connectErr: 'Failed to connect: ',
    codeRead: 'Pairing code detected. Click Connect to continue.',
    sendingDone: 'All files sent successfully.',
    sendingDoneShort: 'Transfer complete',
    sendStopped: 'Transfer interrupted. Check device connection.',
    receiving: 'Receiving: ',
    receivingNotice: 'Receiving ',
    download: 'Download ',
    completed: 'Completed: ',
    receivedOk: 'File received successfully.',
    qrScanned: 'QR code scanned. Click Connect.',
    camErr: 'Could not start camera. Please enter code manually.'
  }
};

function t(key) { return i18n[currentLang][key] || key; }

// Language Switcher
const arBtn = $('arBtn'), enBtn = $('enBtn');
function setLang(lang) {
  currentLang = lang;
  const isAr = lang === 'ar';
  document.documentElement.lang = lang;
  document.documentElement.dir = isAr ? 'rtl' : 'ltr';
  document.querySelectorAll('[data-ar]').forEach(el => {
    el.innerHTML = el.dataset[lang];
  });
  arBtn.classList.toggle('active', isAr);
  enBtn.classList.toggle('active', !isAr);
}
arBtn.addEventListener('click', () => setLang('ar'));
enBtn.addEventListener('click', () => setLang('en'));

// UI Helpers
function notice(id, msg, type = '') {
  const el = $(id);
  el.textContent = msg;
  el.className = 'notice ' + type;
}

function setNet(on, msg) {
  $('lamp').classList.toggle('on', on);
  $('netStatus').textContent = msg;
}

// Tabs
document.querySelectorAll('[data-tab]').forEach(b => b.onclick = () => {
  document.querySelectorAll('[data-tab]').forEach(x => x.classList.toggle('active', x === b));
  document.querySelectorAll('.panel').forEach(x => x.classList.toggle('active', x.id === b.dataset.tab));
});

// WebRTC PeerJS Logic
function makePeer(id) { return new Peer(id, { debug: 1 }); }
function randCode() {
  return Array.from(crypto.getRandomValues(new Uint8Array(4)))
    .map(x => x.toString(16).padStart(2, '0'))
    .join('')
    .toUpperCase();
}

$('createRoom').onclick = () => {
  if (peer) peer.destroy();
  room = randCode();
  peer = makePeer('drop-' + room);
  notice('sendNotice', t('creatingConn'));

  peer.on('open', id => {
    setNet(true, t('readyToPair'));
    $('qrPlaceholder').classList.add('hidden');
    $('qrcode').innerHTML = '';
    $('roomCode').textContent = room;
    $('qrcode').classList.remove('hidden');
    new QRCode($('qrcode'), {
      text: location.origin + location.pathname + '?join=' + room,
      width: 170,
      height: 170,
      colorDark: '#071923',
      colorLight: '#ffffff'
    });
    $('senderFiles').classList.remove('hidden');
    notice('sendNotice', t('roomReady'), 'good');
  });

  peer.on('connection', c => {
    if (conn) { c.close(); return; }
    conn = c;
    wireConnection();
    notice('sendNotice', t('peerPaired'), 'good');
    $('sendFiles').disabled = !files.length;
  });

  peer.on('error', e => {
    notice('sendNotice', t('createErr') + e.type, 'bad');
    setNet(false, t('connError'));
  });
};

function wireConnection() {
  conn.on('open', () => {
    setNet(true, t('connected'));
    $('incoming').classList.remove('hidden');
  });
  conn.on('data', handleData);
  conn.on('close', () => {
    setNet(false, t('connLost'));
    notice('receiveNotice', t('peerClosed'), 'bad');
  });
  conn.on('error', () => notice('receiveNotice', t('peerErr'), 'bad'));
}

$('joinRoom').onclick = () => {
  const code = $('joinCode').value.trim().toUpperCase();
  if (!/^[A-F0-9]{8}$/.test(code)) {
    notice('receiveNotice', t('invalidCode'), 'bad');
    return;
  }
  connect(code);
};

function connect(code) {
  if (peer) peer.destroy();
  peer = makePeer();
  notice('receiveNotice', t('connecting'));
  peer.on('open', () => {
    conn = peer.connect('drop-' + code, { reliable: true, serialization: 'binary' });
    wireConnection();
    conn.on('open', () => notice('receiveNotice', t('connectedOk'), 'good'));
  });
  peer.on('error', e => notice('receiveNotice', t('connectErr') + e.type, 'bad'));
}

// Auto-fill from QR URL parameter
const params = new URLSearchParams(location.search);
if (params.has('join')) {
  $('joinCode').value = params.get('join').toUpperCase();
  document.querySelector('[data-tab="receive"]').click();
  notice('receiveNotice', t('codeRead'), 'good');
}

// File Selection & Drag/Drop
function renderFiles() {
  $('fileList').innerHTML = '';
  files.forEach(f => {
    let d = document.createElement('div');
    d.className = 'fileline';
    d.textContent = '📄 ' + f.name + ' · ' + (f.size / 1024 / 1024).toFixed(2) + ' MB';
    $('fileList').append(d);
  });
  $('sendFiles').disabled = !files.length || !conn || !conn.open;
}

function addFiles(list) {
  files = [...files, ...Array.from(list)];
  renderFiles();
}

$('fileInput').onchange = e => addFiles(e.target.files);
$('drop').onclick = () => $('fileInput').click();
$('drop').ondragover = e => { e.preventDefault(); $('drop').classList.add('drag'); };
$('drop').ondragleave = () => $('drop').classList.remove('drag');
$('drop').ondrop = e => {
  e.preventDefault();
  $('drop').classList.remove('drag');
  addFiles(e.dataTransfer.files);
};

// Chunked File Transfer
const wait = ms => new Promise(r => setTimeout(r, ms));
async function sendOne(file) {
  const chunkSize = 16 * 1024;
  conn.send({ type: 'start', name: file.name, size: file.size, mime: file.type || 'application/octet-stream' });
  let offset = 0;
  while (offset < file.size) {
    const buf = await file.slice(offset, offset + chunkSize).arrayBuffer();
    conn.send(buf);
    offset += buf.byteLength;
    $('sendBar').style.width = (offset / file.size * 100) + '%';
    $('sendProgress').textContent = `${file.name}: ${Math.round(offset / file.size * 100)}%`;
    while (conn.dataChannel && conn.dataChannel.bufferedAmount > 1024 * 1024) await wait(40);
    await wait(4);
  }
  conn.send({ type: 'end' });
}

$('sendFiles').onclick = async () => {
  if (!conn || !conn.open) return;
  $('sendFiles').disabled = true;
  try {
    for (const f of files) await sendOne(f);
    notice('sendNotice', t('sendingDone'), 'good');
    $('sendProgress').textContent = t('sendingDoneShort');
  } catch (e) {
    notice('sendNotice', t('sendStopped'), 'bad');
  } finally {
    $('sendFiles').disabled = false;
  }
};

function handleData(data) {
  if (data && typeof data === 'object' && !(data instanceof ArrayBuffer) && !(data instanceof Uint8Array) && data.type) {
    if (data.type === 'start') {
      received = { name: data.name, size: data.size, mime: data.mime, chunks: [], got: 0 };
      $('incoming').classList.remove('hidden');
      $('receiveProgress').textContent = t('receiving') + data.name;
      notice('receiveNotice', t('receivingNotice') + data.name + '...', 'good');
    } else if (data.type === 'end' && received) {
      const blob = new Blob(received.chunks, { type: received.mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = received.name;
      a.className = 'btn alt';
      a.style.marginBottom = '8px';
      a.textContent = '⬇ ' + t('download') + received.name;
      $('receivedFiles').append(a);
      $('receivedFiles').append(document.createElement('br'));
      $('receiveBar').style.width = '100%';
      $('receiveProgress').textContent = t('completed') + received.name;
      notice('receiveNotice', t('receivedOk'), 'good');
      received = null;
    }
    return;
  }
  if (received) {
    const part = data instanceof ArrayBuffer ? data : data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength);
    received.chunks.push(part);
    received.got += part.byteLength;
    $('receiveBar').style.width = Math.min(100, received.got / received.size * 100) + '%';
    $('receiveProgress').textContent = `${received.name}: ${Math.round(received.got / received.size * 100)}%`;
  }
}

// Camera QR Scanner
$('scanBtn').onclick = async () => {
  try {
    const video = $('camera');
    cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
    video.srcObject = cameraStream;
    video.classList.remove('hidden');
    $('scanPlaceholder').classList.add('hidden');
    await video.play();
    reader = new ZXing.BrowserMultiFormatReader();
    reader.decodeFromVideoElement(video, (result, err) => {
      if (result) {
        try {
          const u = new URL(result.getText());
          const code = u.searchParams.get('join');
          if (code) {
            $('joinCode').value = code.toUpperCase();
            cameraStream.getTracks().forEach(t => t.stop());
            video.classList.add('hidden');
            $('scanPlaceholder').classList.remove('hidden');
            notice('receiveNotice', t('qrScanned'), 'good');
          }
        } catch (e) {}
      }
    });
  } catch (e) {
    notice('receiveNotice', t('camErr'), 'bad');
  }
};
</script>
